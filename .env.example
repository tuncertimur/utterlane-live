# Utterlane Live configuration. Copy to `.env` (never commit `.env`), or to `config.env` in the
# data folder (`utterlane doctor` prints it) to keep keys out of the app folder.
# Every setting is optional. Environment variables override both files.

# ---------------------------------------------------------------- conversation
UTTERLANE_LANGUAGE=tr                 # tr | en
UTTERLANE_ASSISTANT_NAME=Lena         # the wake name ("Utterlane" always works too)
UTTERLANE_MODE=smart                  # smart | always | wake

# ------------------------------------------------------------------ the brain
# Where replies come from. Pick ONE block.

# 1) OpenAI (default when OPENAI_API_KEY is set). Spend is capped (USD).
# OPENAI_API_KEY=
# UTTERLANE_BRAIN_MODEL=gpt-6-luna
# UTTERLANE_BUDGET_CAP_USD=2

# 2) Your OpenClaw agent (enable the Gateway's /v1/responses endpoint first; see docs/INTEGRATIONS.md)
# UTTERLANE_BRAIN=openclaw
# UTTERLANE_BRAIN_API_KEY=            # openclaw gateway auth-token --show
# UTTERLANE_BRAIN_MODEL=openclaw/default

# 3) Your Hermes Agent (API_SERVER_ENABLED=true in ~/.hermes/.env, then `hermes gateway`)
# UTTERLANE_BRAIN=hermes
# UTTERLANE_BRAIN_API_KEY=            # the API_SERVER_KEY you set for Hermes

# 4) A local model, free and offline (Ollama or LM Studio)
# UTTERLANE_BRAIN=ollama
# UTTERLANE_BRAIN_MODEL=qwen3:8b

# 5) Any other OpenAI-compatible server, or your own webhook
# UTTERLANE_BRAIN=chat                # chat | responses | webhook
# UTTERLANE_BRAIN_URL=http://127.0.0.1:8000/v1
# UTTERLANE_BRAIN_MODEL=my-model
# UTTERLANE_BRAIN_API_KEY=

# 6) No replies: transcription + speaker labels only (an agent can still use the MCP tools)
# UTTERLANE_BRAIN=none

# Who may make the brain reply: all | named (introduced themselves) | enrolled (voice saved).
# OpenClaw / Hermes default to "named" because they can run tools.
# UTTERLANE_BRAIN_SPEAKERS=named
# Stateful agents receive only new turns; plain models get the recent history.
# UTTERLANE_BRAIN_HISTORY=latest       # latest | full
# UTTERLANE_BRAIN_SESSION=utterlane-room
# Extra request headers: UTTERLANE_BRAIN_HEADER_<Name_With_Underscores>=value

# ------------------------------------------------------------------- hardware
# UTTERLANE_STT_MODEL=auto             # auto | large-v3-turbo | small
# UTTERLANE_STT_DEVICE=auto            # auto | cuda | cpu
# UTTERLANE_TTS_ENGINE=pocket          # pocket | none
# UTTERLANE_TTS_VOICE=default          # tr: female_1..3 male_1..3 | en: anna, eve, george, …
# UTTERLANE_TTS_DEVICE=auto

# -------------------------------------------------------------------- server
# UTTERLANE_HOST=127.0.0.1             # keep loopback unless you set a token
# UTTERLANE_PORT=8765
# UTTERLANE_API_TOKEN=                 # required for REST/MCP/WebSocket when set
# UTTERLANE_DATA_DIR=                  # models, encrypted voice profiles, logs
